# Odoo TEST — MCP "odoo" (ODOO_PREFIX=LIFEDEPORTES)
ODOO_TARGET=test
ODOO_LIFEDEPORTES_URL=https://testlifesoluciones.odoo.com
ODOO_LIFEDEPORTES_DB=testlifesoluciones
ODOO_LIFEDEPORTES_USERNAME=info@lifedeportes.com
ODOO_LIFEDEPORTES_PASSWORD=tu_api_key_o_password_aqui

# Scripts Python viejos (odoo_connector.py) leen ODOO_* sin prefijo → deben ser TEST
ODOO_URL=https://testlifesoluciones.odoo.com
ODOO_DB=testlifesoluciones
ODOO_USERNAME=info@lifedeportes.com
ODOO_PASSWORD=tu_api_key_o_password_aqui
ODOO_TIMEOUT=30
ODOO_VERIFY_SSL=true
# URLs públicas de tienda que el agente/WhatsApp comparte (opcional; default = ODOO_URL)
ODOO_SHOP_PUBLIC_URL=https://testlifesoluciones.odoo.com

# product.product id del servicio Diseño en test (obligatorio en odoo_create_lead_and_so)
LIFE_DESIGN_PRODUCT_ID=504

# Odoo PRODUCCIÓN — MCP "odoo-prod" (ODOO_PREFIX=LIFEDEPORTES_PROD)
ODOO_LIFEDEPORTES_PROD_URL=https://life-soluciones.odoo.com
ODOO_LIFEDEPORTES_PROD_DB=life-soluciones
ODOO_LIFEDEPORTES_PROD_USERNAME=info@lifedeportes.com
ODOO_LIFEDEPORTES_PROD_PASSWORD=tu_api_key_produccion_aqui

GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Kapso (opcional) — IDs de WhatsApp Flow publicados; ver kapso/whatsapp_flows/kapso_flow_registry.json
# KAPSO_API_BASE_URL=https://api.kapso.ai
# KAPSO_API_KEY=
# KAPSO_FLOW_QUOTE_ID=
# KAPSO_FLOW_PAYMENT_ID=
# KAPSO_FLOW_ORDER_ID=

# Formulario C+B: payload (default) | cells | both
FORMULARIO_FILL_MODE=payload
