dotenv .env

# Desarrollo local: MCP y scripts usan SOLO la instancia test de Life Deportes.
export ODOO_TARGET="${ODOO_TARGET:-test}"
export ODOO_URL="${ODOO_LIFEDEPORTES_URL:?Set ODOO_LIFEDEPORTES_URL in .env}"
export ODOO_DB="${ODOO_LIFEDEPORTES_DB:?Set ODOO_LIFEDEPORTES_DB in .env}"
export ODOO_USERNAME="${ODOO_LIFEDEPORTES_USERNAME:?Set ODOO_LIFEDEPORTES_USERNAME in .env}"
export ODOO_PASSWORD="${ODOO_LIFEDEPORTES_PASSWORD:?Set ODOO_LIFEDEPORTES_PASSWORD in .env}"
export ODOO_PREFIX="${ODOO_PREFIX:-LIFEDEPORTES}"
