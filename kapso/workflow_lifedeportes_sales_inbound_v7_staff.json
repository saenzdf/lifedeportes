            "ask_about_file",
            "enter_waiting",
            "complete_task",
            "handoff_to_human"
          ],
          "sandbox_enabled": false,
          "sandbox_network_mode": "allow_all",
          "sandbox_allowed_outbound_hosts": [],
          "flow_agent_function_tools": [
            {
              "name": "buscar_producto_odoo",
              "description": "Busca producto en Odoo y devuelve precio unitario/total para validar nombre y cantidad antes de subir pedido.",
              "function_id": "4503ca5c-7114-4442-bada-112be3ddf67e",
              "function_name": "odoo-search-product-price",
              "input_schema": {
                "type": "object",
                "properties": {
                  "product_text": {
                    "type": "string",
